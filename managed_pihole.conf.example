# managed_pihole settings - copy to /etc/managed_pihole.conf (or managed_pihole.conf
# next to the scripts), then:  sudo chmod 600 /etc/managed_pihole.conf
# Every line is optional. Environment variables with the same name win.
# Version: 1.4.0 | Updated: 11/6/2026 | Claude Code (Anthropic) - Claude Opus 5.5

# ---- Which filter do the scripts manage? ----
#DNS_FILTER=pihole                 # pihole (default) | adguardhome

# ---- Pi-hole v6 ----
#PIHOLE_MODE=auto                  # auto | native | docker
#PIHOLE_CONTAINER=pihole           # docker container name
#PIHOLE_COMPOSE_DIR=/opt/pihole    # folder with docker-compose.yml (image updates)
#PIHOLE_API_URL=http://127.0.0.1/api
#PIHOLE_DIR=/etc/pihole            # docker: host path of the /etc/pihole volume
#PIHOLE_PASSWORD=                  # web or app password; empty = use /etc/pihole/cli_pw

# ---- AdGuard Home ----
#ADGUARD_URL=http://127.0.0.1
#ADGUARD_USER=admin
#ADGUARD_PASSWORD=
#ADGUARD_SOCIAL_CLIENTS=           # 'kid-laptop|192.168.0.50' allowed to use social media

# ---- Unbound ----
#UNBOUND_UPSTREAM=127.0.0.1:5335   # AdGuard Home upstream (setup_unbound.sh sets this up)
#UNBOUND_PORT=5335
#UNBOUND_IPV6=yes

# ---- mcp_server.py (read-only stats for AI agents) ----
#MCP_SERVICES=pihole,unbound       # any of pihole, adguardhome, unbound (default: DNS_FILTER + unbound)
#UNBOUND_CONTROL=auto              # auto | e.g. "docker exec unbound unbound-control" | "sudo unbound-control"
#UNBOUND_CONTAINER=unbound         # used by auto when unbound-control is not installed on the host

# ---- Backups (backup_dbs.py; daily job: sudo ./backup_dbs.py --install-timer) ----
#BACKUP_DIR=/home/pi/pihole_backups  # default: /home/pi/pihole_backups, else ~/pihole_backups
#BACKUP_KEEP=4                     # newest N of each kind are kept
#BACKUP_TIME=03:00                 # time of day for --install-timer (local time)
#BACKUP_SERVICES=auto              # auto (all found) | any of pihole,unbound,adguardhome
#ADGUARD_CONF=                     # native AdGuardHome.yaml, if not in /opt/AdGuardHome or the snap
#ADGUARD_CONTAINER=adguardhome     # docker container names used to find the config
#UNBOUND_CONTAINER=unbound

# ---- update_lists.sh ----
#MANAGED_PIHOLE_REPO=https://raw.githubusercontent.com/c2theg/managed_pihole/main
#SKIP_OS_UPDATE=0
#SKIP_DOWNLOAD=0
#SKIP_PIHOLE_UPDATE=0
